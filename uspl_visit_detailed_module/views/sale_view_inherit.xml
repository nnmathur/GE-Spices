<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_visitor_sales_form_inherits" model="ir.ui.view">
        <field name="name">visitor.sales.form.inherit</field>
        <field name="model">visitor.sales</field>
        <field name="inherit_id" ref="uspl_distributer_sale.view_visitor_sales_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//div[@class='oe_title mb24']" position="before">
                <div name="button_box" class="oe_button_box">
                    <button name="action_open_visits" type="object" class="oe_stat_button" invisible="visit_count == 0" icon="fa-arrows">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value text-denger">
                                <field name="visit_count" readonly='1'/>
                            </span>
                            <span class=" text-denger">
                                Visits
                            </span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
