<odoo>
    <data>
        <!-- Form Start -->
            <record id="visit_detailed_wizard_form" model="ir.ui.view">
                <field name="name">visit.detailed.wizard.form</field>
                <field name="model">visit.detailed.wizard</field>
                <field name="arch" type="xml">
                    <form string="Release Stock">
                        <sheet>
                            <div class="oe_title mb24">
                                <h1>                            
                                    <field id="distributer_id" class="text-break" name="distributer_id" required='1' placeholder='Enter Distributor...'/>
                                </h1>                         
                            </div>
                            <group>
                                <notebook>
                                    <page string='Product Line'>
                                        <field name='line_ids'>
                                            <list editable='bottom' create='0' edit='1' delete='0'>
                                                <field name='selct'/>
                                                <field name='product_id'/>
                                                <field name='quantity'/>
                                                <field name='converted_quantity'/>
                                                <field name='price'/>
                                            </list>
                                        </field>
                                    </page>
                                </notebook>
                            </group>
                        </sheet>
                        <footer>
                            <button name="action_create_sale_order" string="Allocate" type="object" class="btn-primary"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </footer>
                    </form>
                </field>
            </record>
        <!-- Form End -->

        <record id="action_detailed_wizard" model="ir.actions.act_window">
            <field name="name">Visit Wizard</field>
            <field name="res_model">visit.detailed.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="uspl_visit_detailed_module.visit_detailed_wizard_form"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Visit Wizard were made for this product yet!
                </p>
            </field>
        </record>

    </data>

</odoo>
