<odoo>
    <record id="view_order_form_fixed_discount" model="ir.ui.view">
        <field name="name">sale.order.form.fixed.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="attributes">
                <attribute name='readonly'>1</attribute>
            </xpath>
            <!-- <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="attributes">
                <attribute name='optional'>hide</attribute>
                <attribute name='string'>Main Qty.</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="custom_qty"/>
            </xpath> -->
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="after">
                <field name="fixed_discount"/>
                <field name="fixed_discount_amt" optional='hide'/>
                <field name="damage_discount"/>
                <field name="damage_discount_amt" optional='hide'/>
                <field name="spl_discount"/>
                <field name="spl_discount_amt" optional='hide'/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='discount']" position="after">
                <field name="fixed_discount"/>
                <field name="fixed_discount_amt"/>
                <field name="damage_discount"/>
                <field name="damage_discount_amt"/>
                <field name="spl_discount"/>
                <field name="spl_discount_amt"/>
            </xpath>

            <!-- <xpath expr="//field[@name='tax_totals']" position="before">
                <group>
                    <field name="amount_fixed_discount" readonly="1"/>
                </group>
            </xpath> -->
        </field>
    </record>
</odoo>
