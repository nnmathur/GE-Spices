<odoo>
    <record id="view_move_form_fixed_discount" model="ir.ui.view">
        <field name="name">account.move.form.fixed.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add fixed discount in invoice lines -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="attributes">
                <attribute name='readonly'>1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="after">
                <field name="pkd_date"/>
                <field name="mrp"/>
                <field name="packing"/>
                <!-- <field name="fixed_discount"/>
                <field name="fixed_discount_amt" optional='hide'/> -->
                <field name="damage_discount"/>
                <field name="damage_discount_amt" optional='hide'/>
                <field name="spl_discount"/>
                <field name="spl_discount_amt" optional='hide'/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='discount']" position="after">
                <field name="pkd_date"/>
                <field name="mrp"/>
                <field name="packing"/>
                <!-- <field name="fixed_discount"/>
                <field name="fixed_discount_amt"/> -->
                <field name="damage_discount"/>
                <field name="damage_discount_amt"/>
                <field name="spl_discount"/>
                <field name="spl_discount_amt"/>
            </xpath>

            <!-- Show total fixed discount at bottom -->
            <!-- <xpath expr="//sheet//div[@name='totals']/group/group" position="before">
                <group>
                    <field name="amount_fixed_discount" readonly="1"/>
                </group>
            </xpath> -->
        </field>
    </record>
</odoo>
