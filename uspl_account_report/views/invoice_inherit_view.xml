<odoo>
    <record id="view_move_form_fixed_discount" model="ir.ui.view">
        <field name="name">account.move.form.fixed.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="ref" string='Customer Reference' invisible="move_type not in ('out_invoice', 'out_refund')" readonly="state != 'draft'"/>
                <field name="buyers_po_date" invisible="move_type not in ('out_invoice', 'out_refund')" readonly="state != 'draft'"/>
            </xpath>
            <!-- Add fixed discount in invoice lines -->
            <!-- <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="attributes">
                <attribute name='readonly'>1</attribute>
            </xpath> -->
            <!-- <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="after">
                <field name="pkd_date"/>
                <field name="mrp"/>
                <field name="packing"/>
                <field name="damage_discount"/>
                <field name="damage_discount_amt" optional='hide'/>
                <field name="spl_discount"/>
                <field name="spl_discount_amt" optional='hide'/>
            </xpath> -->
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='price_unit']" position="before">
                <field name="mrp"/>
            </xpath>
            <!-- <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='discount']" position="after">
                <field name="pkd_date"/>
                <field name="packing"/>
                <field name="damage_discount"/>
                <field name="damage_discount_amt"/>
                <field name="spl_discount"/>
                <field name="spl_discount_amt"/>
            </xpath> -->

            <!-- Show total fixed discount at bottom -->
            <xpath expr="//form" position="inside">
                <field name="total_qty" invisible='1'/>
            </xpath>
        </field>
    </record>

    <!-- Company view inherit -->
    <record id="view_company_form_inhherit" model="ir.ui.view">
        <field name="name">res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="before">
                <field name="fssai_license_no" />
            </xpath>
        </field>
    </record>
</odoo>
