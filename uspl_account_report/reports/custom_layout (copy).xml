<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="external_layout_boxed_custom">
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"/></t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"/></t>
            <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
                <div class="o_boxed_header" style="width: 100%; border: 2px solid black; padding-top: 5px; padding-left: 5px; padding-bottom: 5px">
                    <div class="row mb0">
                        <div class="col-12 text-center">
                            <span style="font-size: 26px; color : #0c1252;"><b>Tax Invoice</b></span>
                        </div>
                    </div>
                    <div class="row mb0">
                        <div class="col-12 text-left">
                            <span style="font-size: 16px; color : black;"><b>IRN No:-  <span t-field="o.l10n_in_irn_number"/></b></span>
                        </div>
                    </div>
                    <!--<div class="row mb0">-->
                    <!--    <div class="col-4 text-left">-->
                    <!--        <span style="font-size: 15px; color : black;"><b>Ack No:- </b> <span t-field="o.invoice_date"/></span>-->
                    <!--    </div>-->
                    <!--    <div class="col-4 text-left">-->
                    <!--        <span style="font-size: 15px; color : black;"><b>Ack Date:- </b> <span t-field="o.invoice_date"/></span>-->
                    <!--    </div>-->
                    <!--</div>-->
                    <div class="row mb0">
                        <div class="col-4">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="margin-top:10px; margin-left:20px; width: 180px; hight:180px;"/>
                        </div>
                        
                        <div class="col-4 text-left mt-3">
                            <span style="font-size: 16px; color : black;"><b>Ack No:- </b> <span t-field="o.ack_no"/></span><br/>
                            <span style="font-size: 16px; color : black;"><b>Ack Date:- </b> <span t-field="o.ack_date" t-options="{'widget': 'date','format': 'dd-MM-yyyy'}"/></span><br/>
                            <span style="font-size: 16px; color : black;"><b>Invoice No. :- <span t-out="doc.name"/></b></span><br/>
                            <span style="font-size: 16px; color : black;"><b>e-Way B.No. :- <span t-out="doc.l10n_in_transportation_doc_no"/></b></span><br/>
                            <span style="font-size: 16px; color : black;"><b>Invoice Dt. :- <span t-out="doc.invoice_date" t-options="{&quot;widget&quot;: &quot;date&quot;,&quot;format&quot;: &quot;dd-MM-yyyy&quot;}"/></b></span>
                        </div>
                        
                        <div class="col-4 mt-3" style="font-size: 15px; color: black;">
                            <div class="mt0 h4" t-field="company.report_header"/>
                            <div name="company_address" class="float-end mb4">
                                <strong><span t-if="company.name" t-field="company.name" style="font-size: 17px; color: black;"/></strong>
                                    <br/>
                                    <t t-if="company.street">
                                        <span t-field="company.street"/>,
                                    </t>
                                    <t t-if="company.street2">
                                        <br/>
                                        <span t-field="company.street2"/>,
                                    </t>
                                    <br/>
                                    <t t-if="company.city">
                                        <span t-field="company.city"/>,
                                    </t>
                                    <t t-if="company.zip">
                                        - <span t-field="company.zip"/>
                                    </t>
                                    <strong>
                                    <t t-if="company.udyam">
                                        <br/>
                                        <span> UDYAM: </span>
                                        <span t-field="company.udyam"/>
                                    </t>
                                    <t t-if="company.vat">
                                        <br/>
                                        <span> GSTIN/UIN: </span>
                                        <span t-field="company.vat"/>
                                    </t>
                                    <t t-if="company.state_id">
                                        <br/>
                                        <span> State Name: </span>
                                        <span t-field="company.state_id.name"/>,
                                        <span> Code: </span>
                                        <span t-field="company.state_id.l10n_in_tin"/>
                                    </t>
                                    <t t-if="company.company_registry">
                                        <br/>
                                        <span> CIN: </span>
                                        <span t-field="company.company_registry"/>
                                    </t>
                                    </strong>
                                    <!-- <t t-if="company.mobile or company.phone">
                                    <br/>
                                        <span> Phone - </span>
                                        <span t-field="company.mobile"/>,
                                        <span t-field="company.phone"/>
                                    </t>
                                    <t t-if="company.email">
                                    <br/>
                                        <span> Email - </span>
                                        <span t-field="company.email"/>
                                    </t>
                                    <t t-if="company.website">
                                    <br/>
                                        <span> Web - </span>
                                        <span t-field="company.website"/>
                                    </t> -->
                                    
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div t-attf-class="article o_report_layout_boxed o_company_#{company.id}_layout {{  'o_report_layout_background' if company.layout_background in ['Geometric', 'Custom']  else  '' }}" t-attf-style="background-image: url({{ 'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/bg_background_template.jpg' }});" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <div class="pt-0 mt-0">
                    <t t-call="web.address_layout"/>
                </div>
                <t t-out="0"/>
            </div>

            <!-- <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
                <div class="o_footer_content d-flex border-top pt-2">
                    <div class="flex-grow-1 text-start me-2" t-field="company.report_footer"/>
                    <div class="text-end text-muted">
                        This is a Computer Generated Invoice
                        <div t-if="report_type == 'pdf'" class="text-nowrap">Page <span class="page"/> / <span class="topage"/></div>
                    </div>
                </div>
            </div>
 -->
            <div t-attf-class="footer o_boxed_footer o_company_#{company.id}_layout">
                <div class="text-center text-muted" style="border-top: 1px solid black;">
                    <div t-if="report_type == 'pdf'">
                        <p>
                            This is a Computer Generated Invoice
                            <br/>
                            <div t-if="report_type == 'pdf'" class="text-nowrap">Page <span class="page"/> / <span class="topage"/></div>
                        </p>
                    </div>
                </div>
            </div>
        </template>

        <template id="sale_external_layout_boxed_custom">
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"/></t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"/></t>
            <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
                <!--<div class="o_boxed_header" style="font-size: 12px;">-->
                <div class="o_boxed_header" style="width: 100%; border: 2px solid black; padding-top: 5px; padding-left: 5px; padding-bottom: 5px">
                    <div class="row mb0">
                        <div class="col-4 text-center mt-1 ml-1" style="color: black;">
                           <strong>GSTIN : <span t-field="company.vat"/></strong>
                        </div>
                        <div class="col-8 text-right mt-1 ml-1" style="color: black;">
                        </div>
                    </div>
                    <div class="row mb0">
                        <div class="col-4">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="margin-top:20px; margin-left:30px; width: 210px; hight:210px;"/>
                        </div>

                        <div class="col-8 text-center mb-1" style="font-size: 14px; color: black;">
                            <span style="text-decoration: underline; font-size: 14px; color: black;">Quotation</span><br/>
                            <span t-if="company.name" t-field="company.name" style="font-size: 32px; color: black;"/>
                            <br/>
                            <t>
                                <span t-if="company.street" t-field="company.street"/><span t-if="company.street2">, </span><span t-if="company.street2" t-field="company.street2"/>,
                            </t>
                            <br/>
                            <t>
                                <span t-field="company.city"/> (<span t-field="company.state_id.name"/>)
                            </t>                            
                            <em>
                                <t t-if="company.mobile or company.phone">
                                    <br/>
                                    <span> Tel.  :  </span>
                                    <span t-field="company.mobile"/><span t-if="company.phone">, </span>
                                    <span t-field="company.phone"/>
                                </t>
                                <t t-if="company.email">
                                    <span>  Email  :  </span>
                                    <span t-field="company.email"/>
                                </t>
                            </em>
                        </div>
                    </div>
                </div>
            </div>

            <div t-attf-class="article o_report_layout_boxed o_company_#{company.id}_layout {{  'o_report_layout_background' if company.layout_background in ['Geometric', 'Custom']  else  '' }}" t-attf-style="background-image: url({{ 'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/bg_background_template.jpg' }});" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <div class="pt-0 mt-0">
                    <!-- This div ensures that the address is not cropped by the header. -->
                    <t t-call="web.address_layout"/>
                </div>
                <t t-out="0"/>
            </div>

            <div t-attf-class="footer o_boxed_footer o_company_#{company.id}_layout">
                <div class="text-center" style="font-size: 8px;">
                    <!-- <div t-field="company.report_footer"/> -->
                    <div t-if="report_type == 'pdf'">
                        <p>
                            Should you have any enquiries concerning this invoice, please contact <span t-if="company.name" t-field="company.name"/>
                            <br/>
                            <span t-if="company.street" t-field="company.street">, </span><span t-if="company.street" t-field="company.street">, </span>
                            <span t-if="company.city" t-field="company.city">, </span>
                            <span t-if="company.state_id" t-field="company.state_id.name">, </span>
                            <span t-if="company.zip" t-field="company.zip">, </span>
                            <br/>
                            <span t-if="company.email" t-field="company.email"/>  |   <span t-if="company.website" t-field="company.website"/>
                        </p>
                    </div>
                </div>
            </div>
        </template>
    </data>
</odoo>