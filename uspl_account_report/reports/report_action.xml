<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="account_custom_paper_format" model="report.paperformat">
            <field name="name">Account Paper Formate</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <!-- <field name="orientation">Landscape</field> -->
            <field name="margin_top">160</field>
            <field name="margin_bottom">70</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">160</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_account_report" model="ir.actions.report">
            <field name="name">Print Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">uspl_account_report.report_account</field>
            <field name="report_file">uspl_account_report.report_account</field>
            <field name="print_report_name">'Invoice - %s' % (object.name)
            </field>
            <field name="binding_model_id" ref="uspl_account_report.model_account_move"/>
            <field name="paperformat_id" ref="uspl_account_report.account_custom_paper_format"/>
            <field name="binding_type">report</field>
        </record>

