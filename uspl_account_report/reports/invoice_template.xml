<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice Report Start-->
        <template id="report_account_account">
            <!--<div class="col-auto col-12 mw-100" style="width: 100%; border: 2px solid black;">-->
            <t t-call="uspl_account_report.external_layout_boxed_custom">
              <div style="width: 100%; border: 2px solid black;">
                  <t t-set="doc" t-value="o"/>
                  <t t-set="company" t-value="doc.company_id"/>
                    <div class="col-auto col-12 mw-100 ">
                        <t t-set="uom_name" t-value=" "/>
                        <table class="table table-sm o_main_table mt-0 mb-0" style="width:100%; table-layout: fixed;">
                            <tr style="background-color: #DDD9C4; color:black; font-size: 13px;">
                                <th style="width:3%; text-align: left;">Sr. No.</th>
                                <th style="width:12%; text-align: left;">No. &amp; Kind of Package</th>
                                <th style="width:22%; text-align: left;">Description of Goods</th>
                                <th style="width:10%; text-align: left;">HSN/SAC</th>
                                <th style="width:12%; text-align: right;">MRP/Marginal</th>
                                <th style="width:12%; text-align: right;">Quantity</th>
                                <th style="width:10%; text-align: right;">Rate / Unit</th>
                                <th style="width:10%; text-align: right;">Dist.(%)</th>
                                <th style="width:12%; text-align: right;">Amount</th>
                            </tr>
                            <t t-set="sr_no" t-value="0"/>
                            <t t-foreach="doc.invoice_line_ids" t-as="line">
                                <t t-set="sr_no" t-value="sr_no+1"/>
                                <t t-set="uom_name" t-value="line.product_uom_id.name"/>
                                <tr style="font-size: 12px; color:black;">
                                    <t> 
                                        <td style="text-align: right;" name="th_sr">
                                            <span t-esc="sr_no"/>
                                        </td>
                                        <td style="text-align: right;" name="th_packing">
                                            <span t-if="line.sale_line_ids">
                                                <span t-if="line.sale_line_ids[0].product_packaging_id">
                                                    <t t-esc="line.sale_line_ids[0].product_packaging_qty"/> <t t-esc="line.sale_line_ids[0].product_packaging_id.name"/>
                                                </span>
                                                <span t-else="">
                                                    N/A
                                                </span>
                                            </span>
                                            <span t-else="">
                                                N/A
                                            </span>
                                        </td>
                                        <td style="text-align: left;" name="th_product">
                                            <span t-if="line.product_id" t-field="line.product_id.display_name"/>
                                            <span t-else="" t-field="line.name"/>
                                        </td>
                                        
                                        <td>
                                            <!--<t t-esc="line.product_id.default_code"/><br/>-->
                                            <!--<b>HSN Code:</b> -->
                                            <t t-esc="line.product_id.l10n_in_hsn_code"/>
                                        </td>
                                        
                                        <td style="text-align: right;" name="th_priceunit">
                                            <span t-options="{'widget': 'float', 'precision': 2}" t-field="line.mrp"/>
                                        </td>
                                        
                                        <td style="text-align: right;" name="th_qty">
                                            <span t-field="line.quantity"/> <span t-field="line.product_uom_id"/>
                                        </td>
                                        
                                        <td style="text-align: right;" name="th_priceunit">
                                            <span t-options="{'widget': 'float', 'precision': 2}" t-field="line.price_unit"/>
                                        </td>
    
                                        <td style="text-align: right;" name="th_hsn">
                                            <span t-field="line.discount"/> %
                                        </td>
                                        
                                        <td name="td_subtotal" class="text-end o_price_total">
                                            <span class="text-nowrap" t-field="line.price_subtotal" t-options="{'widget': 'float', 'precision': 2}">27.00</span>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </table>

                        <table class="table table-sm table-borderless" style="width:100%; table-layout: fixed; margin-top:-12px;">    
                            <tr>
                                <th name="th_sr" style="width:40%;text-align: left; margin-left:4px;"/>
                                <th name="th_sr" style="width:30%;text-align: left;"> </th>
                                <th name="th_sr" style="width:30%;text-align: left;"> </th>
                            </tr>
                            <t t-set="tax_list" t-value="doc.get_tax_summry()"/>                      
                            <t t-foreach="tax_list" t-as="tax">
                                <tr style="font-size: 12px; color:black;">
                                    <t> 
                                        <td style="text-align: center;" name="th_sr">
                                        </td>
                                        <td style="text-align: center;" name="th_sr">
                                        </td>

                                        <td style="text-align: center;" name="th_sr">
                                            <div t-if="doc.is_igst" class="col-auto col-12">
                                                <div class="row pt-0" style="margin-left:4px;"> 
                                                    <div style="text-align:left;" class="col-6">
                                                        <b><t t-esc="tax['tax_type']"/></b>
                                                    </div>
                                                    <div style="text-align:right;" class="col-6">
                                                        <b><t t-esc="tax['amt']" t-options="{'widget': 'float', 'precision': 2}"/></b>
                                                    </div>
                                                </div>
                                            </div>
                                            <div t-if="not doc.is_igst" class="col-auto col-12">
                                                <div class="row pt-0" style="margin-left:4px;"> 
                                                    <div style="text-align:left;" class="col-6">
                                                        <b>CGST Output <t t-esc="tax['tax_type']"/></b>
                                                    </div>
                                                    <div style="text-align:right;" class="col-6">
                                                        <b><t t-esc="tax['amt']" t-options="{'widget': 'float', 'precision': 2}"/></b>
                                                    </div>
                                                </div>

                                                <div class="row pt-0" style="margin-left:4px;"> 
                                                    <div style="text-align:left;" class="col-6">
                                                        <b>SGST Output <t t-esc="tax['tax_type']"/></b>
                                                    </div>
                                                    <div style="text-align:right;" class="col-6">
                                                        <b><t t-esc="tax['amt']" t-options="{'widget': 'float', 'precision': 2}"/></b>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                            <tr style="font-size: 14px; color:black; border-top: 1px solid black; margin-top:-12px;">
                                <t> 
                                    <td style="text-align: right;" name="th_sr">
                                        <b>Total</b>
                                    </td>
                                    <td style="text-align: right;" name="th_sr">
                                        <b><t t-esc="doc.total_qty"/><t t-esc="uom_name"/></b>
                                    </td>
                                    <td style="text-align: right;" name="th_sr">
                                        <b><span class="text-nowrap" t-field="doc.amount_total" t-options="{'widget': 'float', 'precision': 2}">27.00</span></b>
                                    </td>
                                </t>
                            </tr>
                        </table>

                        <table class="table table-sm table-borderless" style="width:100%; table-layout: fixed; border-top: 1px solid black; margin-top:-12px;  margin-bottom:-4px;">    
                            <tr style="margin-top:-12px;">
                                <th name="th_sr" style="width:90%;text-align: left; margin-left:4px;"/>
                                <th name="th_sr" style="width:10%;text-align: left;"> </th>
                            </tr>
                            <tr style="font-size: 13px; color:black; margin-top:-12px;">
                                <t> 
                                    <td style="text-align: left;" name="th_sr">
                                        <b>Amount Chargeable (In Words)</b>
                                    </td>
                                    <td style="text-align: right;" name="th_sr">
                                        E. &amp; O.E
                                    </td>
                                </t>
                            </tr>
                            <tr style="font-size: 15px; color:black; margin-top:-12px;">
                                <t> 
                                    <td style="text-align: left;" name="th_sr">
                                        <b><t t-esc="doc.amount_total_words"/></b>
                                    </td>
                                    <td style="text-align: right;" name="th_sr">
                                        
                                    </td>
                                </t>
                            </tr>
                        </table>

                        <!-- <div class="text-center" style="background-color: black; color: white;"><b>HSN Summary </b></div> -->
                        <table class="table table-sm o_main_table mt-0 mb-0" style="width:100%; table-layout: fixed;">
                            <tr style="background-color: #DDD9C4; color:black; font-size: 13px;">
                                <th name="th_hsn" style="width:12%;text-align: left;">HSN/SAC</th>
                                <th name="th_net" style="width:8%;text-align: right;">Taxable Amt.</th>
                                <th t-if="doc.is_igst" name="th_cg_rate" style="width:8%;text-align: right;">IGST Rate</th>
                                <th t-if="doc.is_igst" name="th_cg_amt" style="width:8%;text-align: right;">IGST Amt.</th>
                                <th t-if="not doc.is_igst" name="th_cg_amt" style="width:8%;text-align: right;">CGST Rate</th>
                                <th t-if="not doc.is_igst" name="th_cg_amt" style="width:8%;text-align: right;">CGST Amt.</th>
                                <th t-if="not doc.is_igst" name="th_sg_rate" style="width:8%;text-align: right;">SGST Rate</th>
                                <th t-if="not doc.is_igst" name="th_sg_amt" style="width:8%;text-align: right;">SGST Amt.</th>
                                <th name="th_total" style="width:8%;text-align: right;">Total Tax Amt.</th>
                                <!-- <th name="th_total" style="width:8%;text-align: right;">Total Amt.</th> -->
                            </tr>
                            <t t-set="price_subtotal" t-value="0"/>
                            <t t-set="cgst" t-value="0"/>
                            <t t-set="igst" t-value="0"/>
                            <t t-set="total_tax" t-value="0"/>
                            <t t-foreach="doc.invoice_line_ids" t-as="line">
                                <t t-set="price_subtotal" t-value="price_subtotal + line.price_subtotal"/>
                                <tr style="font-size: 12px; color:black;">
                                    <t>
                                      <td style="text-align: left;" name="th_hsn">
                                          <span t-field="line.product_id.l10n_in_hsn_code"/>
                                      </td>
                                      <td name="td_subtotal" class="text-end o_price_total">
                                        <span class="text-nowrap" t-field="line.price_subtotal" t-options="{'widget': 'float', 'precision': 2}">27.00</span>
                                      </td>

                                      <t t-set="igsst_tax_rate" t-value="0"/>
                                      <t t-if="line.tax_ids and doc.is_igst" t-set="igsst_tax_rate" t-value="line.tax_ids[0].amount"/>

                                      <td t-if="doc.is_igst" style="text-align: right;" name="th_igst_rate">
                                          <span t-esc="igsst_tax_rate"/> % IGST
                                      </td>
                                      <t t-set="igst_tax_amt" t-value="line.price_total - line.price_subtotal"/>
                                      <td t-if="doc.is_igst" style="text-align: right;" name="th_igst_amt">
                                          <span t-esc="igst_tax_amt" t-options="{'widget': 'float', 'precision': 2}"/>
                                          <t t-set="igst" t-value="igst + igst_tax_amt"/>
                                      </td>

                                      <t t-set="gst_tax_rate" t-value="0"/>
                                      <t t-if="line.tax_ids and not doc.is_igst" t-set="gst_tax_rate" t-value="line.tax_ids[0].children_tax_ids[0].amount"/>

                                      <td t-if="not doc.is_igst" style="text-align: right;" name="th_igst_rate">
                                          <span t-esc="gst_tax_rate"/> % CGST
                                      </td>
                                      <t t-set="gst_tax_amt" t-value="(line.price_total - line.price_subtotal)/2"/>
                                      <td t-if="not doc.is_igst" style="text-align: right;" name="th_igst_amt">
                                          <span t-esc="gst_tax_amt" t-options="{'widget': 'float', 'precision': 2}"/>
                                          <t t-set="cgst" t-value="cgst + gst_tax_amt"/>
                                      </td>

                                      <td t-if="not doc.is_igst" style="text-align: right;" name="th_igst_rate">
                                          <span t-esc="gst_tax_rate"/> % SGST
                                      </td>
                                      <td t-if="not doc.is_igst" style="text-align: right;" name="th_igst_amt">
                                          <span t-esc="gst_tax_amt" t-options="{'widget': 'float', 'precision': 2}"/>
                                      </td>

                                      <t t-set="tax_amt" t-value="line.price_total - line.price_subtotal"/>
                                      <td name="td_tax_amt" class="text-end o_price_total">
                                        <span class="text-nowrap" t-esc="tax_amt" t-options="{'widget': 'float', 'precision': 2}"/>
                                        <t t-set="total_tax" t-value="total_tax + tax_amt"/>
                                      </td>

                                      <!-- <td style="text-align: right;" name="th_total">
                                          <span t-options="{'widget': 'float', 'precision': 2}" t-field="line.price_total"/>
                                      </td> -->

                                  </t>
                                </tr>
                            </t>

                            <tr style="color:black; font-size: 13px;">
                                <td style="text-align: right;">Total</td>
                                <td t-esc="price_subtotal" style="text-align: right;" t-options="{'widget': 'float', 'precision': 2}"/>
                                <td t-if="doc.is_igst"/>
                                <td t-if="doc.is_igst" t-esc="igst" style="text-align: right;" t-options="{'widget': 'float', 'precision': 2}"/>
                                <td t-if="not doc.is_igst"/>
                                <td t-if="not doc.is_igst" t-esc="cgst" style="text-align: right;" t-options="{'widget': 'float', 'precision': 2}"/>
                                <td t-if="not doc.is_igst"/>
                                <td t-if="not doc.is_igst" t-esc="cgst" style="text-align: right;" t-options="{'widget': 'float', 'precision': 2}"/>
                                <td name="th_total" t-esc="total_tax" style="text-align: right;" t-options="{'widget': 'float', 'precision': 2}"/>
                            </tr>
                          </table>

                        <!-- <table class="table table-sm table-borderless" style="width:100%; table-layout: fixed;">
                            <tr>
                                <th name="th_sr" style="width:100%;text-align: left; margin-left:4px; color: black;"></th>
                            </tr>
                            <tr style="font-size: 15px; color:black;">
                                <td style="text-align: left;" name="th_sr">
                                    <t t-set="amt_word" t-value="doc.compute_amount_in_words(total_tax)"/>
                                    <span style="margin-left:4px;">
                                        <b>Tax Amount (in Words) : <t t-esc="amt_word"/></b>
                                    </span>
                                </td>
                            </tr>
                            <tr style="font-size: 15px; color:black;">
                                <td style="text-align: left;" name="th_sr">
                                    <t t-set="amt_word" t-value="doc.compute_amount_in_words(total_tax)"/>
                                    <span style="margin-left:4px;">
                                        <b>Company's PAN : <t t-esc="company.l10n_in_pan"/></b>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td style="" name="th_sr">
                                    <div class="col-auto col-12">
                                        <div class="row pt-0" style="margin-left:4px;"> 
                                            <div style="text-align:left;" class="col-6">
                                                <b>Declaration</b><br/>
                                                <span>We declair that this invoice shows the actual price of goods  described and that all particulars are true and correct </span>
                                            </div>
                                            <div style="text-align:right;" class="col-6">
                                                For <t t-esc="company.name" style="font-size: 22px;"/>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td style="" name="th_sr">
                                    <div class="col-auto col-12">
                                        <div class="row pt-0" style="margin-left:4px;"> 
                                            <div style="text-align:left;" class="col-6">
                                                <b>Terms &amp; Conditions :- </b><br/>
                                                <t t-esc="doc.narration"/>
                                            </div>
                                            <div style="text-align:right;" class="col-6">
                                                Authorised Signature
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table> -->

                    </div>
                </div>
            </t>
        </template>

        <template id="report_account">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="uspl_account_report.report_account_account" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

        <template id="account.report_invoice">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>

                    <t t-if="o.move_type == 'out_invoice'"
                       t-call="uspl_account_report.report_account_account"
                       t-lang="lang"/>

                    <t t-elif="o._get_name_invoice_report() == 'account.report_invoice_document'"
                       t-call="account.report_invoice_document"
                       t-lang="lang"/>
                    <t t-else="" />
                </t>
            </t>
        </template>


    <!-- Material Return Report End-->

</odoo>
