                        <table class="table table-sm o_main_table mt-0 mb-0" style="width:100%; table-layout: fixed;">                          
                            <tr>
                                <th name="th_sr" style="width:50%;text-align: left; margin-left:4px; background-color: black; color: white;">Invoice Summary</th>
                                <th name="th_sr" style="width:50%;text-align: left; background-color: black; color: white; font-size: 11px"> </th>
                            </tr>
                                      
                            <tr style="font-size: 15px; color:black;">
                                <t> 
                                    <td style="text-align: left;" name="th_sr">
                                        <t t-set="amt_word" t-value="doc.compute_amount_in_words(doc.amount_total)"/>
                                        <span style="margin-left:4px;">
                                            <b>Amount in Words: </b><br/>
                                        </span>
                                        <span style="margin-left:4px;">
                                             <t t-esc="amt_word"/>
                                        </span>
                                    </td>

                                    <td style="text-align: left;" name="th_product">
                                        <div class="col-auto col-12">
                                            <div class="row pt-0" style="margin-left:4px;"> 
                                                <t t-set="total_amt" t-value="doc.get_tax_total_amount()"/>
                                                <div style="text-align:left;" class="col-6">
                                                    <b>Total Taxable Amt.</b>
                                                </div>
                                                <div style="text-align:right;" class="col-6">
                                                    <b><t t-options="{'widget': 'float', 'precision': 2}" t-esc="total_amt['total_tax_amt']"/></b>
                                                </div>
                                            </div>
                                            <div t-if="not doc.is_igst" class="row pt-0" style="margin-left:4px;">
                                                <div style="text-align:left;" class="col-6">
                                                    <b>Total CGST</b>
                                                </div>
                                                <div style="text-align:right;" class="col-6">
                                                    <b><t t-options="{'widget': 'float', 'precision': 2}" t-esc="total_amt['sgst']"/></b>
                                                </div>
                                            </div>
                                            <div t-if="not doc.is_igst" class="row pt-0" style="margin-left:4px;">
                                                <div style="text-align:left;" class="col-6">
                                                   <b>Total SGST</b>
                                                </div>
                                                <div style="text-align:right;" class="col-6">
                                                    <b><t t-options="{'widget': 'float', 'precision': 2}" t-esc="total_amt['sgst']"/></b>
                                                </div>
                                            </div>

                                            <div t-if="doc.is_igst" class="row pt-0" style="margin-left:4px;">
                                                <div style="text-align:left;" class="col-6">
                                                    <b>Total IGST</b>
                                                </div>
                                                <div style="text-align:right;" class="col-6">
                                                    <b><t t-options="{'widget': 'float', 'precision': 2}" t-esc="total_amt['igst']"/></b>
                                                </div>
                                            </div>
                                            <div class="row pt-0 pb-0" style="margin-left:4px;margin-bottom:4px;">
                                                <div style="text-align:left;" class="col-6">
                                                   <b>Total Invoice Amt.</b>
                                                </div>
                                                <div style="text-align:right;" class="col-6">
                                                    <b><t t-options="{'widget': 'float', 'precision': 2}" t-esc="total_amt['total_inv_amt']"/></b>
                                                </div>
                                            </div>                          

                                        </div>
                                    </td>
                                </t>
                            </tr>
                            <tr>
                                <td style="text-align: left;" name="th_sr">
                                    <div class="col-auto col-12">
                                        <div class="row pt-0" style="margin-left:4px;"> 
                                            <div style="text-align:left;" class="col-6">
                                                <b>Company's PAN</b>
                                            </div>
                                            <div style="text-align:right;" class="col-6">
                                                <b><t t-esc="company.l10n_in_pan"/></b>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td style="text-align: right;"><strong>For <t t-esc="company.name" style="margin-left:10px; font-size: 22px;"/></strong> <br/> </td>
                            </tr>
                            <tr>
                                <td style="text-align: left;" name="th_sr">
                                    <span style="margin-left:4px;">
                                        <b>Declaration </b><br/>
                                    </span>
                                    <span style="margin-left:4px;">
                                         <t t-esc="doc.narration"/>
                                    </span>
                                </td>
                                <td style="text-align: right;"><strong>Authorised Signature</strong> <br/> </td>
                            </tr>
                        </table>

                    </div>
                </div>
            </t>
        </template>

        <template id="report_account">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="uspl_account_report.report_account_account" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

        <template id="account.report_invoice">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>

                    <t t-if="o.move_type == 'out_invoice'"
                       t-call="uspl_account_report.report_account_account"
                       t-lang="lang"/>

                    <t t-elif="o._get_name_invoice_report() == 'account.report_invoice_document'"
                       t-call="account.report_invoice_document"
                       t-lang="lang"/>
                    <t t-else="" />
                </t>
            </t>
        </template>


    <!-- Material Return Report End-->

</odoo>
