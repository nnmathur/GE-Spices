<?xml version="1.0" encoding="UTF-8"?>
<odoo>    
    <record id="view_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='coach_id']" position="after">
                <field name='is_sales_officer'/>
                <field name='sales_officer_ids' widget="many2many_tags" invisible="not is_sales_officer" required="is_sales_officer"/>
                <field name='is_sales_manager'/>                        
                <field name='sales_manager_ids' widget="many2many_tags" invisible="not is_sales_manager" required="is_sales_manager"/>
            </xpath>
        </field>
    </record>

</odoo>
