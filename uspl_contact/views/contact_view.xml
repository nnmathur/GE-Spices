                <field name='city' invisible='1'/>
            </xpath>
            <xpath expr="//field[@name='zip']" position="replace">
                <field name="zip_id" placeholder="ZIP" class="o_address_zip" readonly="type == 'contact' and parent_id" options="{'no_open' : True, 'no_create' : True}"/>
