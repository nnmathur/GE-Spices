<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visitor_sales_form" model="ir.ui.view">
        <field name="name">visitor.sales.form</field>
        <field name="model">visitor.sales</field>
        <field name="arch" type="xml">
            <form string="Outlet Sales">
                <header>
                    <button name="action_confirmed" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_delivered" string="Delivered" type="object" class="oe_highlight" invisible="state not in ['confirmed','partially_delivered']"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ['draft', 'confirmed']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title mb24">
                        <h1>                            
                            <field id="name" class="text-break" name="name" readonly='1' />
                        </h1>                         
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" required='1' readonly="state != 'draft'"/>
                            <field name="employee_name" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="expected_delivery_date" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string='Order Lines'>
                            <field name='visitor_line_ids' readonly="state != 'draft'">
                                <list editable='bottom'>
                                    <field name='product_id' required='1'/>
                                    <field name='outletname'/>
                                    <field name='quantity'/>
                                    <field name='delivered_quantity' readonly='1' optional='hide'/>
                                    <field name='pending_quantity' optional='hide'/>
                                    <field name='uom_id'/>
                                    <field name='unit_price'/>
                                    <field name='tax_id'/>
                                    <field name='untaxed_amt'/>
                                    <field name='total_tax_amt' column_invisible='1'/>
                                    <field name='total_amt'/>
                                </list>
                            </field>

                            <group>
                                <group>
                                    <field colspan="2" name="notes" nolabel="1" placeholder="Define your terms and conditions ..."/>
                                </group>
                                <group class="oe_subtotal_footer">
                                    <!-- <field name="tax_totals" widget="account-tax-totals-field" nolabel="1" readonly="1"/> -->
                                    <field name="untaxed_amt" readonly="1"/>
                                    <field name="total_tax_amt" readonly="1"/>
                                    <field name="total_amt" readonly="1"/>
                                </group>
                            </group>
                            <div class="clearfix"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_visitor_sales_tree" model="ir.ui.view">
        <field name="name">visitor.sales.list</field>
        <field name="model">visitor.sales</field>
        <field name="arch" type="xml">
            <list string="Visitor Sales">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="employee_name"/>
                <field name="expected_delivery_date"/>
                <field name="untaxed_amt" optional='hide'/>
                <field name="total_tax_amt" optional='hide'/>
                <field name="total_amt" optional='hide'/>
                <field name="company_id" optional='hide'/>
                <field name="state" string='Status' widget="badge" decoration-success="state == 'delivered'" decoration-warning="state == 'confirmed'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'" decoration-muted="state == 'partially_delivered'"/>
            </list>
        </field>
    </record>

    <record id="action_visitor_sales" model="ir.actions.act_window">
        <field name="name">Outlet Sales</field>
        <field name="res_model">visitor.sales</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_visitor_sales_root" name="Outlet Sales"/>
    <menuitem id="menu_visitor_sales" name="Outlet Sales" parent="menu_visitor_sales_root" action="action_visitor_sales"/>

</odoo>
